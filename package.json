{
  "name": "cangaco-game",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node tools/dev.js",
    "build": "vite build --base=./ --manifest && node tools/conferir-dist.js",
    "preview": "vite preview",
    "publicar": "node tools/publicar.js",
    "shot:dist": "npm run build && node tools/trava-de-testes.js node tools/shot.js E-ENTREGA-BUILD --preview",
    "test": "node tools/trava-de-testes.js vitest run",
    "test:transladado": "node tools/trava-de-testes.js vitest run -c vitest.transladado.config.mts",
    "test:longo": "node tools/trava-de-testes.js node tools/test-longo.js",
    "selo:longo": "node tools/selo-longo.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node tools/validate-data.js",
    "shot": "node tools/trava-de-testes.js node tools/shot.js",
    "shot:todos": "node tools/trava-de-testes.js node tools/shot-todos.js",
    "docs:mapa": "node tools/gerar-mapa-construcoes.js",
    "sim": "node tools/sim.js",
    "verify:rapido": "node tools/trava-de-testes.js node scripts/verify-rapido.js",
    "verify": "node tools/trava-de-testes.js node scripts/verify.js",
    "hooks:instalar": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
