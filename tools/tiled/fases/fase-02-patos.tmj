quantidade","type":"int","value":2}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2896,"y":3344}]}],"nextlayerid":4,"nextobjectid":12,"orientation":"orthogonal","properties":[{"name":"fase","type":"string","value":"{\"id\":\"fase-02-patos\",\"fase\":2,\"local\":\"Patos\",\"titulo\":\"A aliança\",\"ato\":\"I\",\"modo\":\"construir\",\"escala\":\"combate\",\"semente\":101002,\"gerador\":\"tools/gerar-fases.mjs\",\"_doc\":\"EMITIDO por tools/gerar-fases.mjs; depois de emitido, a fonte e o .tmj em tools/tiled/fases/ (editar no Tiled e rodar `node tools/mapa-tiled.mjs importar`). Desenho em docs/planos/2026-10-10-campanha-dez-fases.md.\",\"narrativa\":\"O bando marcha atrás dos que fugiram. Em Patos encontra um entreposto do Cabo Branco, e um emissário com uma proposta.\",\"desafio\":\"A primeira cadeia de comida inteira, com prazo. O riacho só se atravessa em dois vaus, e a terra boa fica na margem do jogador.\",\"libera\":{\"predios\":[\"farm\",\"mill\",\"bakery\",\"swine_farm\",\"butchers\",\"tannery\",\"armory_workshop\"],\"tropas\":[\"axe_fighter\",\"bowman\"]},\"objetivos\":{\"vitoria\":[{\"tipo\":\"destruir\",\"lado\":1,\"alvo\":\"predios\"}],\"derrota\":[{\"tipo\":\"perder\",\"lado\":0,\"predios\":[\"storehouse\",\"schoolhouse\"]},{\"tipo\":\"prazo\",\"segundos\":2400}]},\"ondas\":[],\"lados\":[{\"lado\":0,\"nome\":\"Moita Seca\",\"estoque\":{\"gold\":15,\"timber\":30,\"stone\":20,\"loaves\":12,\"sausages\":6}},{\"lado\":1,\"nome\":\"Cabo Branco\",\"estoque\":{}}]}"}],"renderorder":"right-down","tiledversion":"1.10.2","tileheight":32,"tilesets":[{"firstgid":1,"source":"../paleta.tsj"}],"tilewidth":32,"type":"map","version":"1.10","width":128}
