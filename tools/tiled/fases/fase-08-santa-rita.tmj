arrativa\":\"Tudo que o Cabo Branco come, veste e atira passa pelos canaviais e engenhos de Santa Rita.\",\"desafio\":\"Ofensiva com prazo. Quatro alvos longe uns dos outros, e só a cavalaria chega a tempo; mas cavalaria morre para a aguilhada.\",\"libera\":{\"predios\":[\"stables\"],\"tropas\":[\"scout\",\"knight\"]},\"objetivos\":{\"vitoria\":[{\"tipo\":\"destruir\",\"lado\":1,\"alvo\":\"predios\"}],\"derrota\":[{\"tipo\":\"prazo\",\"segundos\":1800}]},\"ondas\":[],\"lados\":[{\"lado\":0,\"nome\":\"Moita Seca\",\"estoque\":{\"gold\":40,\"timber\":30,\"stone\":20,\"loaves\":25,\"sausages\":15}},{\"lado\":1,\"nome\":\"Cabo Branco\",\"estoque\":{}}]}"}],"renderorder":"right-down","tiledversion":"1.10.2","tileheight":32,"tilesets":[{"firstgid":1,"source":"../paleta.tsj"}],"tilewidth":32,"type":"map","version":"1.10","width":128}
