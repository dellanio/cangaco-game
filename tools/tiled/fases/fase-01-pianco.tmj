ue,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":592,"y":656},{"height":0,"id":2,"name":"schoolhouse","point":true,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":752,"y":656},{"height":0,"id":3,"name":"serf","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":4}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":688,"y":880},{"height":0,"id":4,"name":"laborer","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":2}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":816,"y":880},{"height":0,"id":5,"name":"barracks","point":true,"properties":[{"name":"lado","type":"int","value":1}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2512,"y":1744},{"height":0,"id":6,"name":"storehouse","point":true,"properties":[{"name":"lado","type":"int","value":1}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2736,"y":1808},{"height":0,"id":7,"name":"militia","point":true,"properties":[{"name":"lado","type":"int","value":1},{"name":"quantidade","type":"int","value":6}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2640,"y":2000}]}],"nextlayerid":4,"nextobjectid":8,"orientation":"orthogonal","properties":[{"name":"fase","type":"string","value":"{\"id\":\"fase-01-pianco\",\"fase\":1,\"local\":\"Piancó\",\"titulo\":\"O que é nosso\",\"ato\":\"I\",\"modo\":\"construir\",\"escala\":\"combate\",\"semente\":101001,\"gerador\":\"tools/gerar-fases.mjs\",\"_doc\":\"EMITIDO por tools/gerar-fases.mjs; depois de emitido, a fonte e o .tmj em tools/tiled/fases/ (editar no Tiled e rodar `node tools/mapa-tiled.mjs importar`). Desenho em docs/planos/2026-10-10-campanha-dez-fases.md.\",\"narrativa\":\"Homens de lenço azul acamparam dentro do Olho d'Água e estão represando a cacimba. Não vieram conversar.\",\"desafio\":\"Economia crua. Pedra é o gargalo: um lajedo só, e o jogador escolhe entre estrada e prédio. Três ondas pequenas, espaçadas para dar tempo de treinar.\",\"libera\":{\"predios\":[\"schoolhouse\",\"quarry\",\"woodcutters\",\"sawmill\",\"inn\",\"barracks\",\"weapons_workshop\"],\"tropas\":[\"militia\"]},\"objetivos\":{\"vitoria\":[{\"tipo\":\"destruir\",\"lado\":1,\"alvo\":\"predios\"}],\"derrota\":[{\"tipo\":\"perder\",\"lado\":0,\"predios\":[\"storehouse\",\"schoolhouse\"]}]},\"ondas\":[{\"aos_segundos\":420,\"lado\":1,\"de\":{\"gx\":124,\"gy\":64},\"tropas\":[{\"tipo\":\"militia\",\"quantidade\":3}]},{\"aos_segundos\":840,\"lado\":1,\"de\":{\"gx\":124,\"gy\":64},\"tropas\":[{\"tipo\":\"militia\",\"quantidade\":4}]},{\"aos_segundos\":1260,\"lado\":1,\"de\":{\"gx\":124,\"gy\":64},\"tropas\":[{\"tipo\":\"militia\",\"quantidade\":5}]}],\"lados\":[{\"lado\":0,\"nome\":\"Moita Seca\",\"estoque\":{\"gold\":10,\"timber\":25,\"stone\":10,\"loaves\":10}},{\"lado\":1,\"nome\":\"Cabo Branco\",\"estoque\":{}}]}"}],"renderorder":"right-down","tiledversion":"1.10.2","tileheight":32,"tilesets":[{"firstgid":1,"source":"../paleta.tsj"}],"tilewidth":32,"type":"map","version":"1.10","width":128}
