e":"barracks","point":true,"properties":[{"name":"lado","type":"int","value":1}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2192,"y":2128},{"height":0,"id":12,"name":"watchtower","point":true,"properties":[{"name":"lado","type":"int","value":1}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2384,"y":2192},{"height":0,"id":13,"name":"militia","point":true,"properties":[{"name":"lado","type":"int","value":1},{"name":"quantidade","type":"int","value":16}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2064,"y":2320},{"height":0,"id":14,"name":"bowman","point":true,"properties":[{"name":"lado","type":"int","value":1},{"name":"quantidade","type":"int","value":8}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":1936,"y":2128},{"height":0,"id":15,"name":"axe_fighter","point":true,"properties":[{"name":"lado","type":"int","value":1},{"name":"quantidade","type":"int","value":6}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2256,"y":2320}]}],"nextlayerid":4,"nextobjectid":16,"orientation":"orthogonal","properties":[{"name":"fase","type":"string","value":"{\"id\":\"fase-03-soledade\",\"fase\":3,\"local\":\"Soledade\",\"titulo\":\"Cavalo é bicho de rico\",\"ato\":\"I\",\"modo\":\"construir\",\"escala\":\"combate\",\"semente\":101003,\"gerador\":\"tools/gerar-fases.mjs\",\"_doc\":\"EMITIDO por tools/gerar-fases.mjs; depois de emitido, a fonte e o .tmj em tools/tiled/fases/ (editar no Tiled e rodar `node tools/mapa-tiled.mjs importar`). Desenho em docs/planos/2026-10-10-campanha-dez-fases.md.\",\"narrativa\":\"Soledade é passagem obrigatória, e o Cabo Branco pagou os coronéis da região para fechá-la.\",\"desafio\":\"Um corredor entre duas serras, com dois postos no estreito. Três Vaqueiros chegam pelos atalhos da serra e caçam o carregador: a lição é posicionamento.\",\"libera\":{\"predios\":[\"gold_mine\",\"coal_mine\",\"metallurgists\"],\"tropas\":[]},\"objetivos\":{\"vitoria\":[{\"tipo\":\"destruir\",\"lado\":1,\"alvo\":\"predios\"}],\"derrota\":[{\"tipo\":\"perder\",\"lado\":0,\"alvo\":\"tropas\"}]},\"ondas\":[{\"aos_segundos\":600,\"lado\":1,\"de\":{\"gx\":96,\"gy\":4},\"tropas\":[{\"tipo\":\"scout\",\"quantidade\":3}]}],\"lados\":[{\"lado\":0,\"nome\":\"Moita Seca\",\"estoque\":{\"gold\":20,\"timber\":30,\"stone\":30,\"loaves\":15,\"sausages\":10}},{\"lado\":1,\"nome\":\"Cabo Branco\",\"estoque\":{}}]}"}],"renderorder":"right-down","tiledversion":"1.10.2","tileheight":32,"tilesets":[{"firstgid":1,"source":"../paleta.tsj"}],"tilewidth":32,"type":"map","version":"1.10","width":128}
