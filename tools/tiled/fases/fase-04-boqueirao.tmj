ue,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":1680,"y":2320},{"height":0,"id":2,"name":"schoolhouse","point":true,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":1840,"y":2320},{"height":0,"id":3,"name":"inn","point":true,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2000,"y":2320},{"height":0,"id":4,"name":"barracks","point":true,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":1744,"y":2768},{"height":0,"id":5,"name":"reservoir","point":true,"properties":[{"name":"lado","type":"int","value":0}],"rotation":0,"type":"predio","visible":true,"width":0,"x":2000,"y":2064},{"height":0,"id":6,"name":"serf","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":6}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2064,"y":2832},{"height":0,"id":7,"name":"laborer","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":3}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2256,"y":2832},{"height":0,"id":8,"name":"militia","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":8}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":1936,"y":2992},{"height":0,"id":9,"name":"axe_fighter","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":4}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2128,"y":2992},{"height":0,"id":10,"name":"bowman","point":true,"properties":[{"name":"lado","type":"int","value":0},{"name":"quantidade","type":"int","value":4}],"rotation":0,"type":"unidade","visible":true,"width":0,"x":2320,"y":2960}]}],"nextlayerid":4,"nextobjectid":11,"orientation":"orthogonal","properties":[{"name":"fase","type":"string","value":"{\"id\":\"fase-04-boqueirao\",\"fase\":4,\"local\":\"Boqueirão\",\"titulo\":\"Água parada\",\"ato\":\"II\",\"modo\":\"construir\",\"escala\":\"combate\",\"semente\":101004,\"gerador\":\"tools/gerar-fases.mjs\",\"_doc\":\"EMITIDO por tools/gerar-fases.mjs; depois de emitido, a fonte e o .tmj em tools/tiled/fases/ (editar no Tiled e rodar `node tools/mapa-tiled.mjs importar`). Desenho em docs/planos/2026-10-10-campanha-dez-fases.md.\",\"narrativa\":\"O açude de Boqueirão é o segundo maior da região, e o Cabo Branco quer os dois. Chegaram primeiro.\",\"desafio\":\"Defesa pura, sem expansão. A vila é cercada de serra, com uma entrada larga e duas estreitas. Peixe é a comida que não depende de roçado.\",\"libera\":{\"predios\":[\"fishermans\",\"reservoir\",\"watchtower\"],\"tropas\":[\"lance_carrier\"]},\"objetivos\":{\"vitoria\":[{\"tipo\":\"sobreviver\",\"ondas\":6}],\"derrota\":[{\"tipo\":\"proteger\",\"lado\":0,\"predios\":[\"reservoir\"]}]},\"ondas\":[{\"aos_segundos\":300,\"lado\":1,\"de\":{\"gx\":64,\"gy\":126},\"tropas\":[{\"tipo\":\"militia\",\"quantidade\":5}]},{\"aos_segundos\":540,\"lado\":1,\"de\":{\"gx\":2,\"gy\":80},\"tropas\":[{\"tipo\":\"militia\",\"quantidade\":4},{\"tipo\":\"bowman\",\"quantidade\":2}]},{\"aos_segundos\":780,\"lado\":1,\"de\":{\"gx\":125,\"gy\":80},\"tropas\":[{\"tipo\":\"axe_fighter\",\"quantidade\":3}]},{\"aos_segundos\":1020,\"lado\":1,\"de\":{\"gx\":64,\"gy\":126},\"tropas\":[{\"tipo\":\"scout\",\"quantidade\":3},{\"tipo\":\"militia\",\"quantidade\":3}]},{\"aos_segundos\":1260,\"lado\":1,\"de\":{\"gx\":2,\"gy\":80},\"tropas\":[{\"tipo\":\"axe_fighter\",\"quantidade\":3},{\"tipo\":\"bowman\",\"quantidade\":3}]},{\"aos_segundos\":1500,\"lado\":1,\"de\":{\"gx\":64,\"gy\":126},\"tropas\":[{\"tipo\":\"scout\",\"quantidade\":3},{\"tipo\":\"axe_fighter\",\"quantidade\":4},{\"tipo\":\"bowman\",\"quantidade\":3}]}],\"lados\":[{\"lado\":0,\"nome\":\"Moita Seca\",\"estoque\":{\"gold\":25,\"timber\":30,\"stone\":25,\"loaves\":20,\"sausages\":10}},{\"lado\":1,\"nome\":\"Cabo Branco\",\"estoque\":{}}]}"}],"renderorder":"right-down","tiledversion":"1.10.2","tileheight":32,"tilesets":[{"firstgid":1,"source":"../paleta.tsj"}],"tilewidth":32,"type":"map","version":"1.10","width":128}
